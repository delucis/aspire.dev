<?xml version="1.0" encoding="utf-8"?>
<!--
  The repository's NuGet.config only allows nuget.org. Jint 5 (the engine behind astro-jint) is published to a preview feed,
  so this tool restores from its own sources. This mirrors the NuGet.config of the astro-jint repository.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Jint-preview" value="https://f.feedz.io/sebastienros/jint/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="Jint-preview">
      <package pattern="Jint" />
      <package pattern="Jint.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
