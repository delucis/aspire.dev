<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only when ASPIRE_HYBRID_ENGINE=jint. It is the repository NuGet.config plus the Jint preview feed, because
  Jint 5 (the engine behind astro-jint) is not on nuget.org. Only the Jint packages come from the preview feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="https://api.nuget.org/v3/index.json" value="https://api.nuget.org/v3/index.json" />
    <add key="Jint-preview" value="https://f.feedz.io/sebastienros/jint/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="Jint-preview">
      <package pattern="Jint" />
      <package pattern="Jint.*" />
    </packageSource>
    <packageSource key="https://api.nuget.org/v3/index.json">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
