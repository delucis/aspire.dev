---
# The site's <OsAwareTabs> (src/components/OsAwareTabs.astro): its two slots become two tabs written in the body:
#   {% os_tabs %}
#   {% tab "Bash", icon: "seti:shell" %}...unix...{% endtab %}
#   {% tab "PowerShell", icon: "seti:powershell" %}...windows...{% endtab %}
#   {% endos_tabs %}
# (the converter emits these labels and icons, in this order, as the component did). `sync` defaults to "terminal".
# The component's inline script (default the synced tab to PowerShell on Windows and Bash elsewhere when
# localStorage has no choice yet) is replaced by the client tabs script, which does it for `data-os-aware` tabs
# before restoring. Root class: cid-os-aware-tabs (plus cid-sl-tabs: it is a Starlight <Tabs>).
block: true
params: [sync]
---
{%- assign os_sync = sync | default: "terminal" -%}
<starlight-tabs class="cid-sl-tabs cid-os-aware-tabs" data-sync-key="{{ os_sync | escape }}" data-os-aware><div class="tablist-wrapper not-content"><ul role="tablist"></ul></div>{{ body | strip }}<starlight-tabs-restore></starlight-tabs-restore></starlight-tabs>