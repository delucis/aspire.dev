{%- comment -%}
  Generated once from src/frontend/src/components/AppHostBuilder.astro (M3, then hand maintained). Root class
  (components.css scope): cid-app-host-builder.
  Arguments: ahb_heading_level (h2 | h3, default h3), ahb_heading (default appHostBuilder.heading with appHost:
  AppHost), ahb_description (default appHostBuilder.description; false hides it).
  Script: scripts/client/home/apphost-builder.ts with apphost-builder.client.ts ([data-apphost-builder],
  .lang-toggle[data-lang], .toggle[data-toggle], [data-code-lang], .code-variant[data-variant], [data-code-stage],
  [data-editor-caret], [data-code-status], [data-editor-motion-toggle]).
  The code blocks are Douze's fence markup (<pre data-lang data-meta><code>), highlighted by the code worker
  (Expressive Code), as <Code> was: the code step's match must include the pages that render this partial (index.html).
{%- endcomment -%}
{%- assign ahb_level = ahb_heading_level | default: "h3" -%}
{%- if ahb_heading -%}{%- assign ahb_title = ahb_heading -%}{%- else -%}{%- assign ahb_title = "appHostBuilder.heading" | t | replace: "{{appHost}}", "AppHost" -%}{%- endif -%}
{%- if ahb_description == false -%}{%- assign ahb_text = "" -%}{%- elsif ahb_description -%}{%- assign ahb_text = ahb_description -%}{%- else -%}{%- assign ahb_text = "appHostBuilder.description" | t -%}{%- endif -%}
<div
  class="container cid-app-host-builder"
  data-apphost-builder
  data-editor-motion-enabled="true"
  data-examples-error="{{ "appHostBuilder.examplesError" | t }}"
>
  <div class="header" dir="{{ dir | default: "ltr" }}">
    <{{ ahb_level }}>{{ ahb_title }}</{{ ahb_level }}>
    {%- if ahb_text != "" %}
    <p>{{ ahb_text }}</p>
    {%- endif %}

    <div class="lang-toggles">
      <button class="lang-toggle active" data-lang="typescript" aria-pressed="true">
        TypeScript
      </button>
      <button class="lang-toggle" data-lang="csharp" aria-pressed="false">C#</button>
    </div>

    <div class="toggles">
      <button
        class="toggle active"
        data-toggle="frontend"
        data-tooltip-placement="top"
        title="{{ "appHostBuilder.frontendTooltip" | t }}"
        aria-pressed="true"
      >
        {% icon "laptop", size: "1.2rem" %}
        <span>Front end</span>
      </button>

      <button
        class="toggle"
        data-toggle="database"
        data-tooltip-placement="top"
        title="{{ "appHostBuilder.databaseTooltip" | t }}"
        aria-pressed="false"
      >
        {% icon "seti:db", size: "1.2rem" %}
        <span>{{ "appHostBuilder.database" | t }}</span>
      </button>

      <button
        class="toggle"
        data-toggle="api"
        data-tooltip-placement="top"
        title="{{ "appHostBuilder.apiTooltip" | t }}"
        aria-pressed="false"
      >
        {% icon "seti:json", size: "1.2rem" %}
        <span>{{ "appHostBuilder.api" | t }}</span>
      </button>

      <button
        class="toggle"
        data-toggle="container"
        data-tooltip-placement="top"
        title="{{ "appHostBuilder.containerTooltip" | t }}"
        aria-pressed="false"
      >
        {% icon "seti:docker", size: "1.2rem" %}
        <span>{{ "appHostBuilder.container" | t }}</span>
      </button>

      <button
        class="toggle"
        data-toggle="deployment"
        data-tooltip-placement="top"
        title="{{ "appHostBuilder.deploymentTooltip" | t }}"
        aria-pressed="false"
      >
        {% icon "rocket", size: "1.2rem" %}
        <span>{{ "appHostBuilder.deploy" | t }}</span>
      </button>
    </div>
  </div>

  <div
    class="code-display not-content"
    data-apphost-code-display
    data-disable-copy
    data-pagefind-ignore
  >
    <div class="code-stage" data-code-stage hidden>
      <span class="editor-caret" data-editor-caret aria-hidden="true"></span>
    </div>
    <p class="sr-only" data-code-status aria-live="polite" aria-atomic="true">
      TypeScript AppHost code showing Front end.
    </p>
