{%- comment -%}
  typeColorIndex of MemberCard.astro, as a value: h = ((h << 5) - h + code) | 0 over the characters, then
  ((h % 4) + 4) % 4, which is the unsigned h modulo 4. An include used as a function: reads tc_in, sets tc_out.
  Characters outside printable ASCII count as 0 (none in the type names). See ts-color.liquid (Math.abs variant).
{%- endcomment -%}
{%- unless tc_table -%}{%- capture tc_table %} !"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~{% endcapture -%}{%- endunless -%}
{%- assign tc_h = 0 -%}
{%- assign tc_chars = tc_in | default: "" | split: "" -%}
{%- for tc_c in tc_chars -%}
  {%- if tc_c == " " -%}{%- assign tc_code = 32 -%}
  {%- elsif tc_table contains tc_c -%}{%- assign tc_code = tc_table | split: tc_c | first | size | plus: 32 -%}
  {%- else -%}{%- assign tc_code = 0 -%}
  {%- endif -%}
  {%- assign tc_h = tc_h | times: 31 | plus: tc_code | modulo: 4294967296 -%}
{%- endfor -%}
{%- assign tc_out = tc_h | modulo: 4 -%}
